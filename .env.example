# ═══════════════════════════════════════════════════════════════════════════════
# منصة صفقات ذكية — قالب متغيرات بيئة التشغيل الإنتاجية (Environment Configuration Template)
# ═══════════════════════════════════════════════════════════════════════════════
# هام: لا تقم بتضمين أي كلمات مرور أو مفاتيح سرية حقيقية داخل هذا الملف.
# انسخ هذا الملف إلى .env وقم بملء القيم الآمنة الخاصة ببيئتك الإنتاجية.

# ─── 1. إعدادات Django والأمان ───
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-this-to-a-very-secure-random-secret-key-min-50-chars
DJANGO_ALLOWED_HOSTS=safaqat.dz,www.safaqat.dz,localhost,127.0.0.1,backend,web,nginx

# سياسة منع البيانات الوهمية في الإنتاج (معطّل افتراضياً لحماية بيئة العمل)
ENABLE_DEMO_DATA=false

# ─── 2. أمان HTTPS وبروتوكول SSL ───
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# ─── 3. إعدادات قاعدة البيانات (PostgreSQL + pgvector) ───
DB_ENGINE=postgresql
POSTGRES_DB=safaqat_db
POSTGRES_USER=safaqat_user
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_HOST=db
POSTGRES_PORT=5432
# أو عبر رابط اتصال موحد (اختياري):
# DATABASE_URL=postgresql://safaqat_user:password@db:5432/safaqat_db

# ─── 4. ذاكرة التخزين المؤقت والرسائل الفورية (Redis & Channels) ───
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ─── 5. قيود CORS و CSRF للواجهات الرسمية ───
CORS_ALLOWED_ORIGINS=https://safaqat.dz,https://www.safaqat.dz,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://safaqat.dz,https://www.safaqat.dz,http://localhost:5173

# ─── 6. بوابة الدفع الإلكتروني الحكومية (Chargily Pay V2 / SATIM / CIB) ───
CHARGILY_API_KEY=your_chargily_api_key_here
CHARGILY_MODE=test

# ─── 7. محرك الذكاء الاصطناعي السيادي (LLM Gateway) ───
LLM_PROVIDER=rule_based
LLM_MODEL=gemini-1.5-flash
# GEMINI_API_KEY=your_gemini_api_key_here

# ─── 8. منافذ الحاويات والخدمات ───
WEB_PORT=80
SSL_PORT=443
PORT=8000
