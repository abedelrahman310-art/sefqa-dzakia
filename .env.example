# Django & PostgreSQL Backend Configuration (Law 23-12 Architecture)
# Generate a secure 50+ character secret key in production (e.g. using `python -c "import secrets; print(secrets.token_urlsafe(50))"`)
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-50-characters
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,safaqat.dz
DB_ENGINE=postgresql
POSTGRES_DB=safaqat_db
POSTGRES_USER=safaqat_user
POSTGRES_PASSWORD=replace-with-secure-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Client & Legacy Variables
PORT=4000
NODE_ENV=development
VITE_CONTACT_EMAIL=contact@example.com

# LLM Configuration
LLM_PROVIDER=rule_based
LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Host port for Postgres (default 5434)
POSTGRES_HOST_PORT=5434
