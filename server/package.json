{
  "name": "server",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed:dev": "tsx src/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@safaqat/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.31.0",
    "express": "^4.18.2",
    "multer": "2.4.0",
    "mysql2": "^3.9.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.12.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/ui": "^5.0.2",
    "drizzle-kit": "^0.22.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.2.5",
    "supertest": "^7.3.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^5.0.2"
  }
}
