{
  "name": "safaqat",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@8.15.5",
  "scripts": {
    "dev": "concurrently \"pnpm --filter server dev\" \"pnpm --filter client dev\"",
    "build": "pnpm --filter @safaqat/shared build && pnpm --filter client build && pnpm --filter server build",
    "start": "pnpm --filter server start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter server test",
    "db:generate": "pnpm --filter server db:generate"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "workspaces": ["client", "server", "shared"]
}
