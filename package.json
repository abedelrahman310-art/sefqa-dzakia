{
  "name": "safaqat",
  "private": true,
  "version": "0.2.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@8.15.5",
  "scripts": {
    "dev": "pnpm --filter client dev",
    "build": "pnpm --filter @safaqat/shared build && pnpm --filter client build",
    "start": "cd backend && python manage.py runserver 8001",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "cd backend && python -m pytest -q"
  },
  "workspaces": ["client", "shared"]
}
